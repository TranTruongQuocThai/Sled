# Copy thành .env chỉ để chạy local khi dùng PostgreSQL.
# Không commit file .env hoặc chia sẻ các giá trị thật.

SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Tuỳ chọn: bỏ trống khi dùng DATABASE_URL.
# SLED_DATABASE_PATH=warehouse.db
