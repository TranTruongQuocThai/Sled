# Copy thành .env để chạy local với Turso (tuỳ chọn).
# Không commit file .env — không đưa SECRET_KEY / token thật lên GitHub.

# Bắt buộc trên Vercel. Local có thể bỏ trống để dùng SQLite warehouse.db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Production / khi muốn nối Turso từ máy local
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-database-token

# Không cần DATABASE_URL / PostgreSQL cho bản hiện tại.
